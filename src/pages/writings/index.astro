---
import { getCollection } from 'astro:content';
import Index from '../../layouts/Index.astro';
import Gazetteer from '../../components/Gazetteer.astro';

const writings = (await getCollection('logs')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const dayMonthYear = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

const years = [...new Set(writings.map((w) => w.data.date.getUTCFullYear()))];
---

<Index
  title="Writing — Guilherme Carvalho"
  description="Notes and essays by Guilherme Carvalho, Staff Software Engineer at VTEX."
  heading="Writing"
  count={writings.length === 0 ? 'No entries yet' : `${writings.length} ${writings.length === 1 ? 'entry' : 'entries'}, newest first`}
>
  {writings.length === 0 && (
    <p class="empty">Nothing published yet. New writing will appear here.</p>
  )}
  {years.map((year) => (
    <section class="year" aria-labelledby={`y-${year}`}>
      <h2 id={`y-${year}`} class="year__label">{year}</h2>
      <Gazetteer
        symbol="benchmark"
        entries={writings
          .filter((w) => w.data.date.getUTCFullYear() === year)
          .map((w) => ({
            href: `/writings/${w.id}`,
            datetime: w.data.date.toISOString(),
            date: dayMonthYear(w.data.date),
            title: w.data.title,
            description: w.data.description,
          }))}
      />
    </section>
  ))}
</Index>

<style>
  .empty {
    margin-top: 2.5rem;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.1875rem;
    color: var(--ink-3);
  }
</style>
