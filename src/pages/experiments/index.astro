---
import { getCollection } from 'astro:content';
import Index from '../../layouts/Index.astro';
import Gazetteer from '../../components/Gazetteer.astro';
import { statusLabel } from '../../lib/status';

const experiments = (await getCollection('experiments')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const monthYear = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });

const years = [...new Set(experiments.map((e) => e.data.date.getUTCFullYear()))];
---

<Index
  title="Experiments — Guilherme Carvalho"
  description="Tools and side projects built by Guilherme Carvalho."
  heading="Experiments"
  count={`${experiments.length} ${experiments.length === 1 ? 'project' : 'projects'}, newest first`}
>
  {years.map((year) => (
    <section class="year" aria-labelledby={`y-${year}`}>
      <h2 id={`y-${year}`} class="year__label">{year}</h2>
      <Gazetteer
        symbol="summit"
        entries={experiments
          .filter((e) => e.data.date.getUTCFullYear() === year)
          .map((e) => ({
            href: `/experiments/${e.id}`,
            datetime: e.data.date.toISOString(),
            date: monthYear(e.data.date),
            title: e.data.title,
            description: e.data.description,
            meta: [e.data.stack, statusLabel[e.data.status]].filter(Boolean).join(' · '),
          }))}
      />
    </section>
  ))}
</Index>
