---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { statusLabel } from '../../lib/status';

export async function getStaticPaths() {
  const experiments = await getCollection('experiments');
  return experiments.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
const date = data.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const facts = [
  { label: 'Status', value: statusLabel[data.status] },
  ...(data.stack ? [{ label: 'Stack', value: data.stack }] : []),
  ...(data.stats ?? []),
  ...(data.metadata ?? []),
];
---

<Article
  title={data.title}
  description={data.description}
  datetime={data.date.toISOString()}
  date={date}
  back={{ href: '/experiments', label: 'All experiments' }}
  symbol="summit"
  facts={facts}
>
  <Content />
</Article>
