---
import Sheet from '../layouts/Sheet.astro';
import SheetClose from '../components/SheetClose.astro';
import { SURVEYED, decimalYear, makeScale } from '../lib/survey';

const now = new Date();
const present = decimalYear(now);
const scale = makeScale(present);
const ym = (y: number, m: number) => y + (m - 1) / 12;

const roles = [
  {
    id: 'staff',
    company: 'VTEX',
    title: 'Staff Software Engineer',
    range: 'Sep 2023 – present',
    from: ym(2023, 9),
    to: present,
    tone: 'slate',
    body: 'Building and scaling commerce platform infrastructure. Node.js, Software Design, and full-stack architecture in a hybrid setup based in Recife, Brazil.',
  },
  {
    id: 'faststore',
    company: 'VTEX',
    title: 'Engineering Manager',
    range: 'Sep 2021 – Mar 2024',
    from: ym(2021, 8),
    to: ym(2024, 3),
    tone: 'gold',
    body: 'Led engineering teams delivering commerce solutions at scale. Drove technical strategy, team growth, and cross-functional alignment across product and platform initiatives.',
  },
  {
    id: 'guava',
    company: 'Guava Software',
    title: 'Co-founder & Software Developer',
    range: 'Jan 2011 – Aug 2021',
    from: ym(2011, 1),
    to: ym(2021, 8),
    tone: 'moss',
    body: 'Co-founded a Ruby/Rails development studio delivering high-quality, maintainable software. Helped businesses build the technology they need using best-fit tools and architectures.',
  },
];

// The columnar section uses the home map's time scale, present at the top.
const H = 560;
const W = 44;
const y = (t: number) => ((SURVEYED - scale(t)) / SURVEYED) * H;
const column = roles.map((r) => ({ ...r, y0: y(r.to), y1: y(r.from) }));
const overlap = { y0: y(ym(2024, 3)), y1: y(ym(2023, 9)) };
const ticks = [2011, 2016, 2021, 2024, 2026]
  .filter((t) => t <= present)
  .map((t) => ({ t, y: y(t) }));

const materials = [
  'Node.js & TypeScript',
  'Distributed systems',
  'Software design',
  'Ruby on Rails',
  'Python',
  'Vue.js & React',
  'Machine learning',
];
---

<Sheet
  title="About — Guilherme Carvalho"
  description="Guilherme Carvalho: Staff Software Engineer at VTEX, co-founder of Guava Software, MSc in machine learning from CIn/UFPE."
>
  <main class="about">
    <header class="intro">
      <figure class="plate">
        <img src="/profile.webp" alt="Portrait of Guilherme Carvalho" width="875" height="875" />
        <figcaption>Guilherme Carvalho · Recife</figcaption>
      </figure>
      <div class="intro__text">
        <h1>About</h1>
        <div class="bio">
          <p>
            I joined <a href="https://vtex.com" rel="noopener">VTEX</a> in 2021 as an Engineering
            Manager, leading the team that built <a href="https://faststore.dev" rel="noopener">FastStore</a>
            — VTEX's modern storefront framework. In 2023 I moved into a Staff Software Engineer role,
            focused on bringing the FastStore platform to other products inside VTEX, redefining it
            for an AI-first world, and helping raise code delivery quality across the vertical. Most
            of my work here lives in Node.js, TypeScript, and distributed systems.
          </p>
          <p>
            Before that, I co-founded
            <a href="https://web.archive.org/web/20210618065028/https://guava.software/" rel="noopener">Guava Software</a>
            in 2011 — a boutique Ruby/Rails development studio based in Recife. For a decade I acted
            as lead developer across a wide range of client projects: True &amp; Co, MetaMaster,
            <a href="https://petplate.com" rel="noopener">PetPlate</a>, Endossa, and others spanning
            e-commerce, fintech, and civic tech. Our stack centered on Ruby on Rails and Python on the
            backend, Vue.js and React on the frontend. VTEX acquired Guava in 2021.
          </p>
        </div>
      </div>
    </header>

    <section id="roles" class="roles" aria-labelledby="roles-title">
      <h2 id="roles-title" class="section-title">Roles</h2>
      <div class="roles__body">
        <figure class="section-column" aria-hidden="true">
          <svg viewBox={`-44 -8 ${W + 52} ${H + 16}`}>
            <defs>
              <pattern id="col-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                <line x1="0" y1="0" x2="0" y2="6" class="hatch" />
              </pattern>
            </defs>
            {column.map((c) => (
              <rect x="0" y={c.y0} width={W} height={c.y1 - c.y0} class:list={['stratum', `stratum--${c.tone}`]} />
            ))}
            <rect x="0" y={overlap.y0} width={W} height={overlap.y1 - overlap.y0} fill="url(#col-hatch)" />
            {column.map((c) => (
              <line x1="0" x2={W} y1={c.y1} y2={c.y1} class="contact" />
            ))}
            <rect x="0" y="0" width={W} height={column[column.length - 1].y1} class="frame" />
            {ticks.map((k) => (
              <>
                <line x1="-6" x2="0" y1={k.y} y2={k.y} class="tick" />
                <text x="-10" y={k.y} class="tick-label">{k.t}</text>
              </>
            ))}
          </svg>
          <figcaption>Columnar section, present at top. Same time scale as the home map.</figcaption>
        </figure>

        <ol class="roles__list">
          {roles.map((r) => (
            <li class:list={['role', `role--${r.tone}`]}>
              <h3>
                {r.title}
                <span class="role__company">{r.company}</span>
              </h3>
              <p class="role__range">
                <span class="swatch" aria-hidden="true"></span>
                {r.range}
              </p>
              <p class="role__body">{r.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="research" class="research" aria-labelledby="research-title">
      <h2 id="research-title" class="section-title">
        <svg viewBox="0 0 24 14" aria-hidden="true"><path d="M1 9 C6 3, 10 12, 15 6 S21 5, 23 7" /></svg>
        Research
      </h2>
      <div class="research__body">
        <p class="bio">
          I studied Computer Science at <a href="https://cin.ufpe.br" rel="noopener">Centro de
          Informática, UFPE</a>, where I also completed my Master's focused on ensemble methods for
          machine learning. That work led to a couple of published papers, in collaboration with
          researchers at UFPE and UFPR.
        </p>
        <ul class="papers">
          <li>
            <a href="https://ieeexplore.ieee.org/document/6033472" rel="noopener">Pedestrian detection with PCA-based reconstruction</a>
            <span>IEEE</span>
          </li>
          <li>
            <a href="https://www.inf.ufpr.br/lesoliveira/download/PRL2016.pdf" rel="noopener">Combining diversity measures for ensemble pruning</a>
            <span>Pattern Recognition Letters · 2016</span>
          </li>
        </ul>
      </div>
    </section>

    <section class="materials" aria-labelledby="materials-title">
      <h2 id="materials-title" class="section-title">Working materials</h2>
      <ul>
        {materials.map((m) => <li>{m}</li>)}
      </ul>
    </section>
  </main>
  <SheetClose />
</Sheet>

<style>
  .about {
    width: 100%;
    max-width: 72rem;
    padding: clamp(1.5rem, 5vh, 3rem) var(--gutter) clamp(3rem, 8vh, 5rem);
  }

  /* ------------------------------------------------------------ intro */

  .intro {
    display: grid;
    grid-template-columns: minmax(12rem, 20rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }

  /* The portrait is printed as a plate: ink on the sheet's own paper. */
  .plate {
    border: 1.5px solid var(--neat);
    outline: 0.5px solid var(--neat);
    outline-offset: 4px;
    margin: 5px;
    background: var(--page);
  }

  .plate img {
    display: block;
    width: 100%;
    height: auto;
    filter: grayscale(1) sepia(0.3) brightness(1.35) contrast(0.92);
    mix-blend-mode: multiply;
  }

  .plate figcaption {
    padding: 0.5rem 0.7rem;
    border-top: 1px solid var(--neat);
    font-stretch: 82%;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  @media (prefers-color-scheme: dark) {
    .plate img {
      mix-blend-mode: normal;
      filter: grayscale(1) contrast(1.05) sepia(0.25) brightness(0.9);
    }
  }

  h1 {
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1;
    text-transform: uppercase;
    color: var(--ink);
    padding-bottom: 1rem;
    border-bottom: 1.5px solid var(--neat);
  }

  .bio {
    font-family: var(--serif);
    font-size: 1.1875rem;
    line-height: 1.65;
    color: var(--ink-2);
    max-width: 64ch;
  }

  .intro .bio {
    margin-top: 1.5rem;
  }

  .bio p + p {
    margin-top: 1.1em;
  }

  .bio a,
  .papers a {
    color: var(--ink);
    text-decoration-color: var(--ember);
    text-decoration-thickness: 1.5px;
  }

  .bio a:hover,
  .papers a:hover {
    color: var(--ember);
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-stretch: 125%;
    font-weight: 800;
    font-size: 0.875rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink);
    padding-bottom: 0.75rem;
    border-bottom: 1.5px solid var(--neat);
  }

  section {
    margin-top: clamp(3.5rem, 9vh, 6rem);
    scroll-margin-top: 1.5rem;
  }

  /* ------------------------------------------------------------ roles */

  .roles__body {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    margin-top: 2rem;
  }

  .section-column {
    position: sticky;
    top: 1.5rem;
    align-self: start;
  }

  .section-column svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .section-column figcaption {
    margin-top: 0.75rem;
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--ink-3);
  }

  .stratum--moss { fill: var(--band-moss); }
  .stratum--gold { fill: var(--band-gold); }
  .stratum--slate { fill: var(--band-slate); }
  .hatch { stroke: var(--ink-2); stroke-width: 1; opacity: 0.4; }
  .contact { stroke: var(--ink); stroke-width: 1; }
  .frame { fill: none; stroke: var(--neat); stroke-width: 1.5; }
  .tick { stroke: var(--brick); stroke-width: 1; }

  .tick-label {
    font-family: var(--sans);
    font-stretch: 82%;
    font-size: 11px;
    font-weight: 600;
    fill: var(--brick);
    text-anchor: end;
    dominant-baseline: middle;
  }

  .roles__list {
    display: grid;
    align-content: start;
    gap: 2.75rem;
  }

  .role__range {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-stretch: 88%;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--ink-3);
  }

  .swatch {
    width: 1.5rem;
    height: 0.8rem;
    border: 1px solid var(--neat);
  }

  .role--moss .swatch { background: var(--band-moss); }
  .role--gold .swatch { background: var(--band-gold); }
  .role--slate .swatch { background: var(--band-slate); }

  .role__range {
    margin-top: 0.6rem;
  }

  .role h3 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(1.5rem, 2.6vw, 1.875rem);
    line-height: 1.2;
    color: var(--ink);
  }

  .role__company {
    display: block;
    margin-top: 0.2rem;
    font-family: var(--sans);
    font-stretch: 125%;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .role__body {
    margin-top: 0.8rem;
    font-family: var(--serif);
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 60ch;
  }

  /* ------------------------------------------------------------ research */

  .research .section-title svg {
    width: 1.5rem;
    height: 0.9rem;
    fill: none;
    stroke: var(--water);
    stroke-width: 2;
  }

  .research__body {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    margin-top: 2rem;
  }

  .papers {
    display: grid;
    gap: 1.25rem;
  }

  .papers li {
    display: grid;
    gap: 0.3rem;
    padding-left: 1rem;
    border-left: 1px solid var(--water);
  }

  .papers a {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.1875rem;
    line-height: 1.35;
    color: var(--field-water);
    text-decoration-color: currentColor;
  }

  .papers span {
    font-stretch: 82%;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* ------------------------------------------------------------ materials */

  .materials ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 2.25rem;
    margin-top: 1.5rem;
  }

  .materials li {
    font-family: var(--serif);
    font-size: 1.1875rem;
    color: var(--ink);
  }

  /* ------------------------------------------------------------ small screens */

  @media (max-width: 820px) {
    .intro {
      grid-template-columns: 1fr;
    }

    .plate {
      max-width: 16rem;
    }

    .research__body {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .roles__body {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: 1.25rem;
    }
  }
</style>
